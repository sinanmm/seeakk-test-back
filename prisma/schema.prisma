  @@index([workspaceId, deletedAt, updatedAt])
  @@index([workspaceId, name])
  @@map("sheets")
}

model SheetVersion {
  id          String   @id @default(cuid())
  sheetId     String
  workspaceId String
  version     Int
  name        String
  columns     Json
  rows        Json
  formatting  Json?
  metadata    Json?
  createdAt   DateTime @default(now())
  createdById String?

  sheet     Sheet     @relation(fields: [sheetId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User?     @relation("SheetVersionCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([sheetId, version])
  @@index([workspaceId, sheetId, createdAt])
  @@map("sheet_versions")
}

// ─── SALARY MANAGEMENT MODULE ────────────────────────────────────────────────

enum SalaryRecordStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  RETURNED
}

enum SalaryApprovalAction {
  APPROVED
  REJECTED
  RETURNED
  EDITED
}

model SalaryRecord {
  id                String             @id @default(uuid())
  workspaceId       String
  userId            String
  month             Int                // 1 to 12
  year              Int                // e.g. 2026
  monthlySalary     Float              // Base monthly salary
  workingDays       Int                // Total working days in month
  attendanceDays    Float              // Days present
  leaveDays         Float              // Paid leave days
  lopDays           Float              // Loss of pay days
  overtimeHours     Float              @default(0)
  bonus             Float              @default(0)
  deduction         Float              @default(0)
  advanceAmount     Float              @default(0)
  finalSalary       Float              // Calculated net salary
  status                 SalaryRecordStatus   @default(DRAFT)
  currentStageOrder      Int                  @default(1)
  currentApprovalStageId String?
  currentApproverUserId  String?
  remarks                String?              @db.Text

  generatedById String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  workspace            Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user                 User                 @relation("UserSalaryRecords", fields: [userId], references: [id], onDelete: Cascade)
  generatedBy          User                 @relation("GeneratedSalaryRecords", fields: [generatedById], references: [id])
  currentApprovalStage SalaryApprovalStage? @relation("StageSalaryRecords", fields: [currentApprovalStageId], references: [id])
  currentApproverUser  User?                @relation("CurrentSalaryApprover", fields: [currentApproverUserId], references: [id])
  approvals            SalaryApproval[]
  histories            SalaryHistory[]

  @@unique([workspaceId, userId, month, year])
  @@index([workspaceId])
  @@index([userId])
  @@index([status])
  @@index([workspaceId, currentApproverUserId, status])
  @@index([month, year])
  @@map("salary_records")
}

model SalaryApprovalStage {
  id             String         @id @default(uuid())
  workspaceId    String
  name           String
  order          Int            // 1, 2, 3...
  approverUserId String
  designation    String?
  isMandatory    Boolean        @default(true)
  isActive       Boolean        @default(true)
  salaryRecords  SalaryRecord[] @relation("StageSalaryRecords")

  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  approverUser User      @relation(fields: [approverUserId], references: [id])

  @@unique([workspaceId, order])
  @@index([workspaceId])
  @@index([approverUserId])
  @@map("salary_approval_stages")
}

model SalaryApproval {
  id             String               @id @default(uuid())
  salaryRecordId String
  stageOrder     Int
  approverUserId String
  action         SalaryApprovalAction
  remarks        String?              @db.Text
  createdAt      DateTime             @default(now())

  salaryRecord SalaryRecord @relation(fields: [salaryRecordId], references: [id], onDelete: Cascade)
  approverUser User         @relation(fields: [approverUserId], references: [id])

  @@index([salaryRecordId])
  @@index([approverUserId])
  @@map("salary_approvals")
}

model SalaryHistory {
  id                String       @id @default(uuid())
  salaryRecordId    String
  editedById        String
  action            String
  previousSalary    Float?
  updatedSalary     Float?
  difference        Float?
  previousBonus     Float?
  updatedBonus      Float?
  previousDeduction Float?
  updatedDeduction  Float?
  previousAdvance   Float?
  updatedAdvance    Float?
  stageOrder        Int?
  previousValue     Json?
  newValue          Json?
  reason            String?      @db.Text
  createdAt         DateTime     @default(now())

  salaryRecord SalaryRecord @relation(fields: [salaryRecordId], references: [id], onDelete: Cascade)
  editedBy     User         @relation(fields: [editedById], references: [id])

  @@index([salaryRecordId])
  @@index([editedById])
  @@map("salary_histories")
}

model SalarySetting {
  id               String    @id @default(uuid())
  workspaceId      String    @unique
  salaryReleaseDay Int       @default(25) // e.g. 25th of month
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("salary_settings")
}

model LeadSubstage {
  id                          String      @id @default(cuid())
  workspaceId                 String
  leadStageId                 String
  name                        String
  description                 String?     @db.Text
  sortOrder                   Int         @default(0)
  status                      StageStatus @default(ACTIVE)
  connectionStatusRestriction String?     // "CONNECTED", "NOT_CONNECTED", or null
  outcomeCategory             String?     // "POSITIVE", "FOLLOW_UP", "NEGATIVE", "NEUTRAL"
  createdById                 String?
  createdAt                   DateTime    @default(now())
  updatedAt                   DateTime    @updatedAt
  deletedAt                   DateTime?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  leadStage LeadStage @relation(fields: [leadStageId], references: [id], onDelete: Cascade)
  createdBy User?     @relation("SubstageCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  leads            Lead[]
  leadCallOutcomes LeadCallOutcome[]

  @@unique([workspaceId, leadStageId, name])
  @@index([workspaceId])
  @@index([leadStageId])
  @@index([status])
  @@index([sortOrder])
  @@map("lead_substages")
}

model LeadCallSession {
  id                  String    @id @default(cuid())
  workspaceId         String
  leadId              String
  initiatedById       String
  assignedUserId      String?
  phoneNumberSnapshot String
  sourceContext       String    @default("ALL_LEADS") // ALL_LEADS, LEAD_DETAILS, FOLLOW_UP_POPUP
  followUpId          String?
  initiatedAt         DateTime  @default(now())
  returnedAt          DateTime?
  localCallDate       String    // YYYY-MM-DD
  status              String    @default("INITIATED") // INITIATED, COMPLETED, CANCELLED, FAILED, ANSWERED
  provider            String    @default("DEVICE_DIALER") // DEVICE_DIALER, KNOWLARITY, PLIVO, EXOTEL
  providerCallId      String?
  direction           String?   @default("OUTBOUND") // OUTBOUND, INBOUND
  fromNumber          String?
  toNumber            String?
  duration            Int?      // Duration in seconds
  answeredAt          DateTime?
  endedAt             DateTime?
  recordingAvailable  Boolean   @default(false)
  recordingUrl        String?   @db.Text
  recordingDuration   Int?
  recordingStatus     String?   // PENDING, READY, FAILED, UNAVAILABLE
  recordingDownloadedAt DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  workspace   Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  lead        Lead              @relation(fields: [leadId], references: [id], onDelete: Cascade)
  initiatedBy User              @relation("CallSessionInitiatedBy", fields: [initiatedById], references: [id], onDelete: Restrict)
  followUp    FollowUp?         @relation(fields: [followUpId], references: [id], onDelete: SetNull)
  outcomes    LeadCallOutcome[]

  @@index([workspaceId])
  @@index([leadId])
  @@index([initiatedById])
  @@index([providerCallId])
  @@index([workspaceId, initiatedById, leadId, localCallDate])
  @@index([workspaceId, status, createdAt(sort: Desc)])
  @@map("lead_call_sessions")
}

model LeadCallOutcome {
  id                    String   @id @default(cuid())
  callSessionId         String
  workspaceId           String
  leadId                String
  userId                String
  connectionStatus      String   // CONNECTED, NOT_CONNECTED
  outcomeNotes          String?  @db.Text
  substageId            String?
  previousStageId       String?
  targetStageId         String?
  previousSubstageId    String?
  approvalRequestId     String?
  stageRuleSubmissionId String?
  followUpId            String?
  callPriority          String?  @default("MEDIUM") // HIGH, MEDIUM, LOW
  submittedAt           DateTime @default(now())
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  callSession   LeadCallSession @relation(fields: [callSessionId], references: [id], onDelete: Cascade)
  workspace     Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  lead          Lead            @relation(fields: [leadId], references: [id], onDelete: Cascade)
  user          User            @relation(fields: [userId], references: [id], onDelete: Restrict)
  substage      LeadSubstage?   @relation(fields: [substageId], references: [id], onDelete: SetNull)
  previousStage LeadStage?      @relation("CallOutcomePrevStage", fields: [previousStageId], references: [id], onDelete: SetNull)
  targetStage   LeadStage?      @relation("CallOutcomeTargetStage", fields: [targetStageId], references: [id], onDelete: SetNull)

  @@index([callSessionId])
  @@index([workspaceId])
  @@index([leadId])
  @@index([userId])
  @@index([substageId])
  @@index([workspaceId, userId, connectionStatus, submittedAt(sort: Desc)])
  @@map("lead_call_outcomes")
}

model DashboardPipelineSection {
  id             String    @id @default(cuid())
  workspaceId    String
  name           String
  description    String?   @db.Text
  visibilityType String    @default("PRIVATE") // PRIVATE, SHARED, WORKSPACE
  ownerUserId    String
  layoutType     String    @default("AUTO") // FULL, TWO_COL, THREE_COL, FOUR_COL, AUTO
  sortOrder      Int       @default(0)
  status         String    @default("ACTIVE") // ACTIVE, INACTIVE
  createdById    String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  ownerUser User      @relation("SectionOwnerUser", fields: [ownerUserId], references: [id], onDelete: Cascade)
  createdBy User      @relation("SectionCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  pipelines DashboardPipeline[]
  shares    DashboardPipelineShare[]

  @@index([workspaceId])
  @@index([ownerUserId])
  @@index([status])
  @@index([sortOrder])
  @@map("dashboard_pipeline_sections")
}

model DashboardPipeline {
  id             String    @id @default(cuid())
  workspaceId    String
  sectionId      String
  name           String
  description    String?   @db.Text
  metricType     String    @default("LEAD_COUNT") // LEAD_COUNT, TOTAL_EXPECTED_REVENUE, TOTAL_CLOSED_REVENUE, AVERAGE_REVENUE, CONVERSION_RATE, LOB_COUNT, FOLLOWUP_COUNT, OVERDUE_FOLLOWUP_COUNT, STAGE_DISTRIBUTION
  displayType    String    @default("COMPACT_CARD") // COMPACT_CARD, HORIZONTAL_BAR, PROGRESS_BAR, STATUS_CARD, MINI_TABLE, STAGE_BAR, PERCENTAGE_CARD, REVENUE_CARD
  filtersJson    Json      // Array of normalized conditions
  segmentsJson   Json?     // Array of data segment definitions for PIE_CHART (label, metricType, filtersJson, filterLogic, color)
  filterLogic    String    @default("AND") // AND, OR
  visibilityType String    @default("PRIVATE") // PRIVATE, SHARED, WORKSPACE
  ownerUserId    String
  sortOrder      Int       @default(0)
  status         String    @default("ACTIVE") // ACTIVE, INACTIVE
  clickAction    String    @default("OPEN_LEADS") // OPEN_LEADS, OPEN_DRAWER
  createdById    String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  workspace Workspace                @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  section   DashboardPipelineSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  ownerUser User                     @relation("PipelineOwnerUser", fields: [ownerUserId], references: [id], onDelete: Cascade)
  createdBy User                     @relation("PipelineCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  shares DashboardPipelineShare[]
  audits DashboardPipelineAudit[]

  @@index([workspaceId])
  @@index([sectionId])
  @@index([ownerUserId])
  @@index([status])
  @@index([sortOrder])
  @@map("dashboard_pipelines")
}

model DashboardPipelineShare {
  id                 String   @id @default(cuid())
  workspaceId        String
  sectionId          String?
  pipelineId         String?
  shareType          String   // USER, ROLE, OFFICE, DEPARTMENT
  targetUserId       String?
  targetRoleId       String?
  targetOfficeId     String?
  targetDepartmentId String?
  createdAt          DateTime @default(now())

  workspace        Workspace                 @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  section          DashboardPipelineSection? @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  pipeline         DashboardPipeline?        @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  targetUser       User?                     @relation(fields: [targetUserId], references: [id], onDelete: Cascade)
  targetRole       Role?                     @relation(fields: [targetRoleId], references: [id], onDelete: Cascade)
  targetOffice     Office?                   @relation(fields: [targetOfficeId], references: [id], onDelete: Cascade)
  targetDepartment Department?               @relation(fields: [targetDepartmentId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([sectionId])
  @@index([pipelineId])
  @@index([targetUserId])
  @@index([targetRoleId])
  @@index([targetOfficeId])
  @@index([targetDepartmentId])
  @@map("dashboard_pipeline_shares")
}

model DashboardPipelineAudit {
  id            String   @id @default(cuid())
  workspaceId   String
  pipelineId    String?
  sectionId     String?
  action        String   // SECTION_CREATED, SECTION_UPDATED, SECTION_DELETED, PIPELINE_CREATED, PIPELINE_UPDATED, PIPELINE_DELETED, PIPELINE_SHARED, PIPELINE_DUPLICATED, PIPELINE_ACTIVATED, PIPELINE_DEACTIVATED, PIPELINE_REORDERED
  previousValue Json?
  newValue      Json?
  performedById String
  createdAt     DateTime @default(now())

  workspace Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  pipeline  DashboardPipeline? @relation(fields: [pipelineId], references: [id], onDelete: SetNull)
  performedBy User             @relation(fields: [performedById], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([pipelineId])
  @@index([performedById])
  @@map("dashboard_pipeline_audits")
}

model MetaConnection {
