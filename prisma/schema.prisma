  startDate      DateTime
  endDate        DateTime?
  shiftSession   ShiftSession?
  shiftStartTime String?
  shiftEndTime   String?
  status         RosterStatus  @default(ACTIVE)
  createdBy      String?
  createdAt      DateTime      @default(now())
