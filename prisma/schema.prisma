  @@unique([workspaceId, userId, leadId])
  @@index([workspaceId, userId, isStarred])
  @@index([leadId])
  @@map("lead_stars")
}

model LeadActivity {
  id            String   @id @default(cuid())
  leadId        String
  performedById String?
  workspaceId   String
  action        String
  metadata      Json?
  createdAt     DateTime @default(now())

  lead        Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
