  expiresAt   DateTime
  usedAt      DateTime?
  createdBy   String
  createdAt   DateTime  @default(now())

  user      User      @relation("InviteUser", fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  creator   User      @relation("InviteCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)

  @@index([workspaceId, userId])
  @@index([workspaceId, createdBy])
  @@index([workspaceId, expiresAt])
  @@index([workspaceId, usedAt])
