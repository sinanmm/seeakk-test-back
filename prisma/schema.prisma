  fieldId String

  value     String
  sortOrder Int

  field LeadDynamicField @relation(fields: [fieldId], references: [id], onDelete: Cascade)

  @@index([fieldId])
  @@map("lead_dynamic_options")
}

model LeadDynamicValue {
  id      String @id @default(cuid())
  leadId  String
  fieldId String

  value String

  createdAt DateTime @default(now())

  field LeadDynamicField @relation(fields: [fieldId], references: [id], onDelete: Restrict)
  lead  Lead?            @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@index([fieldId])
  @@map("lead_dynamic_values")
}

model LeadStar {
