generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
  binaryTargets   = ["native", "darwin-arm64", "debian-openssl-3.0.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TargetSettingCycle {
  MONTHLY
  QUARTERLY
  YEARLY
  CUSTOM

  @@map("TargetCycle")
}

enum ViolationType {
  DAILY
  MONTHLY
}

enum LocationType {
  COUNTRY
  STATE
  DISTRICT
  CITY
  WARD
  CONSTITUENCY
  OFFICE
}

enum RoleStatus {
  ACTIVE
  INACTIVE
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  status      RoleStatus @default(ACTIVE)
  description String?

  createdBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  permissions RolePermission[]
  users       User[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid())
  key         String   @unique
  group       String
  description String?

  createdAt   DateTime @default(now())

  roles       RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String

  role         Role       @relation(fields: [roleId], references: [id])
  permission   Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model Workspace {
  id             String       @id @default(cuid())
  companyName    String
  employeeCount  String
  timeZone       String       @default("UTC")
  language       String       @default("en-US")
  currencyLocale String       @default("USD")
  loadSampleData Boolean      @default(false)
  owner          User         @relation("WorkspaceOwner", fields: [ownerId], references: [id])
  ownerId        String       @unique
  users          User[]       @relation("WorkspaceMembers")
  departments    Department[]
  leadSources    LeadSource[]
  leadStages     LeadStage[]
  stageRules     StageRule[]
  targetCycles   TargetCycle[]
  leadLifeCycles LeadLifeCycle[]
  leadDynamicFields LeadDynamicField[]
  leads          Lead[]
  leadActivities LeadActivity[]
  leadStageApprovals LeadStageApproval[]
  holidays           Holiday[]
  holidaySyncLogs    HolidaySyncLog[]
  countries          Country[]
  locationLevels     LocationLevel[]
  lobReasons         LOBReason[]
  reportTypes        ReportType[]
  reports            Report[]
  reportLogs         ReportLog[]
  importJobs         ImportJob[]
  invites            Invite[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@map("workspaces")
}

enum DepartmentStatus {
  ACTIVE
  INACTIVE
}

enum LeadSourceStatus {
  ACTIVE
  INACTIVE
}

enum StageStatus {
  ACTIVE
  INACTIVE
}

enum LeadClosureType {
  WON
  LOST
  CANCELLED
}

enum LeadExpiryAction {
  AUTO_LOB
  WARN_AND_CHOOSE
}

enum LeadApprovalStatus {
  PENDING
  APPROVED
  DENIED
}

enum LeadApprovalState {
  NONE
  PENDING
}

enum ReportTypeStatus {
  ACTIVE
  INACTIVE
}

enum LOBReasonStatus {
  ACTIVE
  INACTIVE
}

enum ReportBaseDataSource {
  LEADS
  USERS
  FOLLOWUPS
}

enum ReportModule {
  LEADS
  USERS
  REPORTS
  TARGETS
  FOLLOWUPS
}

enum InputType {
  TEXT
  TEXTAREA
  RADIO
  SELECT
}

enum RuleStatus {
  ACTIVE
  INACTIVE
}

enum RosterType {
  HOLIDAY
  WEEKLY_OFF
  SHIFT
  SPECIAL_WORKING_DAY
}

enum RosterStatus {
  ACTIVE
  INACTIVE
}

enum ShiftSession {
  DAY
  NIGHT
}

model Department {
  id          String   @id @default(uuid())
  name        String
  description String?
  status      DepartmentStatus @default(ACTIVE)
  
  workspace   Workspace? @relation(fields: [workspaceId], references: [id])
  workspaceId String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  users       User[]

  @@unique([name, workspaceId])
  @@index([workspaceId])
  @@index([name])
  @@index([status])
  @@index([createdAt])
  @@index([workspaceId, deletedAt, status, createdAt(sort: Desc)])
  @@map("departments")
}

model LeadSource {
  id          String           @id @default(uuid())
  workspaceId String
  name        String
  status      LeadSourceStatus @default(ACTIVE)
  createdBy   String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  deletedAt   DateTime?
  workspace   Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  leads       Lead[]

  // Duplicate stage names are allowed by product requirement.
  @@index([workspaceId])
  @@index([name])
  @@index([status])
  @@index([workspaceId, status, createdAt(sort: Desc)])
  @@map("lead_sources")
}

model LeadStage {
  id                 String          @id @default(uuid())
  workspaceId        String
  name               String
  color              String          @default("#10b981")
  isApprovalRequired Boolean         @default(false)
  isLOB              Boolean         @default(false)
  isClosed           Boolean         @default(false)
  order              Int
  status             StageStatus     @default(ACTIVE)
  createdBy          String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  deletedAt          DateTime?
  workspace          Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  rules              StageRule[]
  leads              Lead[]
  approvalsFrom      LeadStageApproval[] @relation("LeadStageApprovalFromStage")
  approvalsTo        LeadStageApproval[] @relation("LeadStageApprovalToStage")

  @@unique([workspaceId, name])
  @@index([workspaceId])
  @@index([name])
  @@index([status])
  @@index([order])
  @@index([workspaceId, status, order])
  @@map("lead_stages")
}

model StageRule {
  id        String     @id @default(uuid())
  workspaceId String
  name      String     @default("Untitled Rule")
  inputType InputType  @default(TEXT)
  /// JSON string[] — choices for RADIO / SELECT
  options   Json?
  sortOrder Int        @default(1)
  required  Boolean    @default(false)
  // Legacy columns kept for backward compatibility to avoid destructive schema pushes.
  legacyField       String? @map("field")
  legacyCondition   String? @map("condition")
  legacyValue       String? @map("value")
  legacyIsMandatory Boolean? @map("isMandatory")
  status    RuleStatus @default(ACTIVE)
  stageId   String?
  createdBy String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @default(now()) @updatedAt
  deletedAt DateTime?

  workspace  Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  stage      LeadStage?       @relation(fields: [stageId], references: [id], onDelete: SetNull)
  leadInputs LeadStageInput[]

  @@unique([workspaceId, name])
  @@index([workspaceId])
  @@index([name])
  @@index([status])
  @@index([sortOrder])
  @@index([stageId])
  @@index([workspaceId, status, sortOrder])
  @@map("stage_rules")
}

model LeadStageInput {
  id        String   @id @default(uuid())
  leadId    String
  ruleId    String
  value     String
  createdAt DateTime @default(now())

  rule StageRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@index([ruleId])
  @@map("lead_stage_inputs")
}

model Office {
  id          String   @id @default(cuid())
  name        String
  address     String?
  countryId   String?
  stateId     String?
  districtId  String?
  isActive    Boolean  @default(true)
  createdBy   String?
  workspaceId String
  users       User[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([workspaceId])
  @@index([name])
  @@index([countryId])
  @@index([stateId])
  @@index([districtId])
  @@map("offices")
}

model Country {
  id          String    @id @default(uuid())
  workspaceId String
  name        String
  code        String?
  isActive    Boolean   @default(true)
  createdById String?
  updatedById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy   User?     @relation("CountryCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy   User?     @relation("CountryUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  levels      LocationLevel[]
  locations   Location[]

  @@index([workspaceId])
  @@index([workspaceId, isActive, createdAt(sort: Desc)])
  @@map("countries")
}

model LocationLevel {
  id          String    @id @default(uuid())
  workspaceId String
  countryId   String
  levelName   String
  levelOrder  Int
  isActive    Boolean   @default(true)
  createdById String?
  updatedById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  country     Country   @relation(fields: [countryId], references: [id], onDelete: Cascade)
  createdBy   User?     @relation("LocationLevelCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy   User?     @relation("LocationLevelUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  locations   Location[]

  @@unique([countryId, levelOrder])
  @@index([workspaceId])
  @@index([countryId, isActive, levelOrder])
  @@map("location_levels")
}

model Location {
  id          String   @id @default(cuid())
  name        String
  type        LocationType
  workspaceId String
  countryId   String?
  levelId     String?
  isActive    Boolean  @default(true)
  createdById String?
  updatedById String?
  deletedAt   DateTime?
  
  parentId    String?
  parent      Location?  @relation("LocationHierarchy", fields: [parentId], references: [id])
  children    Location[] @relation("LocationHierarchy")
  country     Country?   @relation(fields: [countryId], references: [id], onDelete: SetNull)
  level       LocationLevel? @relation(fields: [levelId], references: [id], onDelete: SetNull)
  
  assignedUsers UserLocationAssignment[]
  
  // Potential address relations for users (where they live)
  usersAtCountry  User[] @relation("UserCountry")
  usersAtState    User[] @relation("UserState")
  usersAtDistrict User[] @relation("UserDistrict")

  holidaysAtCountry  Holiday[] @relation("HolidayCountry")
  holidaysAtState    Holiday[] @relation("HolidayState")
  holidaysAtDistrict Holiday[] @relation("HolidayDistrict")

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([workspaceId])
  @@index([parentId])
  @@index([countryId])
  @@index([levelId])
  @@index([workspaceId, countryId, levelId, isActive])
  @@map("locations")
}

model UserLocationAssignment {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  locationId  String
  location    Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  
  workspaceId String
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, locationId])
  @@index([workspaceId])
  @@map("user_location_assignments")
}

model TargetType {
  id          String          @id @default(cuid())
  name        String          @unique // e.g., "Revenue", "Leads Generated"
  description String?
  workspaceId String?         // Optional: Global types or workspace-specific
  settings    TargetSetting[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@map("target_types")
}

model TargetCycle {
  id          String             @id @default(cuid())
  name        String
  workspaceId String

  totalDays   Int
  status      String             @default("ACTIVE")

  createdBy   String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  deletedAt   DateTime?

  workspace   Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  ranges      TargetCycleRange[]
  targets     TargetSetting[]

  @@unique([name, workspaceId])
  @@index([workspaceId])
  @@map("target_cycles")
}

model TargetCycleRange {
  id            String      @id @default(cuid())
  targetCycleId String

  startDay      Int
  endDay        Int

  createdAt     DateTime    @default(now())

  targetCycle   TargetCycle @relation(fields: [targetCycleId], references: [id], onDelete: Cascade)

  @@index([targetCycleId])
  @@map("target_cycle_ranges")
}

model LeadLifeCycle {
  id          String   @id @default(cuid())
  name        String
  isDefault   Boolean  @default(false)

  workspaceId String

  createdBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace   Workspace                 @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  transitions LeadLifeCycleTransition[]
  leads       Lead[]

  @@unique([name, workspaceId])
  @@index([workspaceId])
  @@index([workspaceId, isDefault, name])
  @@map("lead_life_cycles")
}

model Lead {
  id              String        @id @default(cuid())
  name            String
  email           String?
  phone           String?
  expectedRevenue Float?
  generatedRevenue Float        @default(0)
  assignedToId    String?
  stageId         String?
  lifecycleId     String?
  sourceId        String?
  nextFollowUpAt  DateTime?
  stageEnteredAt  DateTime?
  stageExpiresAt  DateTime?
  slaAction       LeadExpiryAction?
  slaWarningDays  Int?
  approvalState   LeadApprovalState @default(NONE)
  pendingApprovalToStageId String?
  pendingApprovalRequestedAt DateTime?
  isClosed        Boolean       @default(false)
  isLOB           Boolean       @default(false)
  closedAt        DateTime?
  closedById      String?
  closureType     LeadClosureType?
  workspaceId     String
  createdById     String
  deletedAt       DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  assignedTo      User?         @relation("LeadAssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)
  stage           LeadStage?    @relation(fields: [stageId], references: [id], onDelete: SetNull)
  lifecycle       LeadLifeCycle? @relation(fields: [lifecycleId], references: [id], onDelete: SetNull)
  source          LeadSource?   @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  createdBy       User          @relation("LeadCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  closedBy        User?         @relation("LeadClosedBy", fields: [closedById], references: [id], onDelete: SetNull)
  workspace       Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  followUps       FollowUp[]
  lobLogs         LeadLOBLog[]
  activities      LeadActivity[]
  stageApprovals  LeadStageApproval[]

  @@index([workspaceId, assignedToId, stageId])
  @@index([workspaceId, sourceId, createdAt])
  @@index([workspaceId, deletedAt])
  @@index([workspaceId, isLOB, isClosed])
  @@index([isClosed])
  @@index([workspaceId, isClosed])
  @@index([closureType])
  @@index([closedAt(sort: Desc)])
  @@index([nextFollowUpAt])
  @@index([workspaceId, isClosed, isLOB, stageExpiresAt])
  @@index([workspaceId, stageId, deletedAt, isClosed])
  @@index([workspaceId, assignedToId, deletedAt, isClosed])
  @@index([workspaceId, sourceId, deletedAt, isClosed])
  @@index([workspaceId, lifecycleId, deletedAt, isClosed])
  @@index([workspaceId, nextFollowUpAt, deletedAt, isClosed])
  @@index([workspaceId, createdAt(sort: Desc), deletedAt, isClosed])
  @@index([workspaceId, approvalState, pendingApprovalRequestedAt])
  @@index([name])
  @@index([email])
  @@index([phone])
  @@map("leads")
}

model LeadLOBLog {
  id          String   @id @default(cuid())
  leadId      String
  reasonId    String
  remarks     String?
  /// Pipeline stage the lead was in immediately before this LOB event (denormalized name for analytics).
  previousStageId   String?
  previousStageName String?
  changedById String
  changedAt   DateTime @default(now())
  workspaceId String

  lead        Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId, changedAt])
  @@index([workspaceId, reasonId])
  @@index([previousStageId])
  @@index([workspaceId, previousStageId])
  @@map("lead_lob_logs")
}

model LOBReason {
  id          String          @id @default(uuid())
  workspaceId String
  name        String
  status      LOBReasonStatus @default(ACTIVE)
  createdById String?
  updatedById String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  deletedAt   DateTime?

  workspace   Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy   User?           @relation("LOBReasonCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy   User?           @relation("LOBReasonUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([status])
  @@index([workspaceId, status, createdAt(sort: Desc)])
  @@map("lob_reasons")
}

model LeadStageApproval {
  id            String             @id @default(cuid())
  workspaceId   String
  leadId        String
  fromStageId   String
  toStageId     String
  requestedById String
  assignedToId  String?
  status        LeadApprovalStatus @default(PENDING)
  comment       String?
  requestData   Json?
  approvedById  String?
  approvedAt    DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  workspace     Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  lead          Lead               @relation(fields: [leadId], references: [id], onDelete: Cascade)
  fromStage     LeadStage          @relation("LeadStageApprovalFromStage", fields: [fromStageId], references: [id], onDelete: Restrict)
  toStage       LeadStage          @relation("LeadStageApprovalToStage", fields: [toStageId], references: [id], onDelete: Restrict)
  requestedBy   User               @relation("LeadStageApprovalRequestedBy", fields: [requestedById], references: [id], onDelete: Restrict)
  assignedTo    User?              @relation("LeadStageApprovalAssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)
  approvedBy    User?              @relation("LeadStageApprovalApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([status])
  @@index([leadId])
  @@index([assignedToId])
  @@index([workspaceId, status, createdAt(sort: Desc)])
  @@index([workspaceId, requestedById, createdAt(sort: Desc)])
  @@map("lead_stage_approvals")
}

model LeadLifeCycleTransition {
  id           String   @id @default(cuid())
  lifecycleId  String
  lifecycle    LeadLifeCycle @relation(fields: [lifecycleId], references: [id], onDelete: Cascade)

  fromStageId  String
  toStageId    String

  numberOfDays Int
  expiryAction LeadExpiryAction @default(WARN_AND_CHOOSE)
  warningDays  Int              @default(1)

  sortOrder    Int

  workspaceId  String

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([lifecycleId])
  @@index([workspaceId])
  @@map("lead_life_cycle_transitions")
}

model LeadDynamicField {
  id          String   @id @default(cuid())
  name        String
  inputType   String
  sortOrder   Int
  isRequired  Boolean  @default(false)
  isActive    Boolean  @default(true)

  workspaceId String

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace   Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  options     LeadDynamicOption[]
  values      LeadDynamicValue[]

  @@unique([name, workspaceId])
  @@index([workspaceId, sortOrder])
  @@index([workspaceId, isActive, inputType, sortOrder])
  @@map("lead_dynamic_fields")
}

model LeadDynamicOption {
  id        String   @id @default(cuid())
  fieldId   String

  value     String
  sortOrder Int

  field     LeadDynamicField @relation(fields: [fieldId], references: [id], onDelete: Cascade)

  @@index([fieldId])
  @@map("lead_dynamic_options")
}

model LeadDynamicValue {
  id        String   @id @default(cuid())
  leadId    String
  fieldId   String

  value     String

  createdAt DateTime @default(now())

  field     LeadDynamicField @relation(fields: [fieldId], references: [id], onDelete: Restrict)

  @@index([leadId])
  @@index([fieldId])
  @@map("lead_dynamic_values")
}

model LeadActivity {
  id           String   @id @default(cuid())
  leadId        String
  performedById String?
  workspaceId   String
  action        String
  metadata      Json?
  createdAt     DateTime @default(now())

  lead          Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  performedBy   User?     @relation("LeadActivityPerformedBy", fields: [performedById], references: [id], onDelete: SetNull)
  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([leadId, createdAt(sort: Desc)])
  @@index([workspaceId, action, createdAt(sort: Desc)])
  @@map("lead_activities")
}

model TargetSetting {
  id                   String     @id @default(cuid())
  user                 User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId               String
  targetType           TargetType @relation(fields: [targetTypeId], references: [id])
  targetTypeId         String
  cycle                TargetSettingCycle @default(MONTHLY)
  targetCycleId        String?
  targetCycle          TargetCycle?       @relation(fields: [targetCycleId], references: [id], onDelete: SetNull)
  
  monthlyTargetLeads   Int        @default(0)
  dailyFollowupTarget  Int        @default(0)
  revenueTarget        Float      @default(0)
  
  startDate            DateTime
  endDate              DateTime?
  
  workspaceId          String
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt

  @@index([userId, workspaceId])
  @@index([targetTypeId])
  @@index([targetCycleId])
  @@map("target_settings")
}

model TargetViolation {
  id           String        @id @default(cuid())
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId       String
  date         DateTime      @default(now())
  type         ViolationType
  attemptCount Int           @default(1)
  status       String        @default("WARNING") // WARNING, FINAL_WARNING, LOCKED
  message      String?
  
  workspaceId  String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([userId, date])
  @@index([workspaceId])
  @@map("target_violations")
}

model User {
  id                       String      @id @default(cuid())
  name                     String?
  username                 String?     @unique
  email                    String      @unique
  password                 String?
  phone                    String?
  googleId                 String?     @unique
  isOnboarded              Boolean     @default(false)
  isActive                 Boolean     @default(true)
  isEmailVerified          Boolean     @default(false)
  isLocked                 Boolean     @default(false) // Target compliance lock
  verificationToken        String?
  verificationTokenExpires DateTime?
  invitationToken          String?
  invitationExpires        DateTime?
  deletedAt                DateTime?

  // Role relation
  role                     Role?       @relation(fields: [roleId], references: [id])
  roleId                   String?

  // Workspace relation
  workspace                Workspace?  @relation("WorkspaceMembers", fields: [workspaceId], references: [id])
  workspaceId              String?
  ownedWorkspace           Workspace?  @relation("WorkspaceOwner")

  // Department relation
  department               Department? @relation(fields: [departmentId], references: [id])
  departmentId             String?

  // Office relation
  office                   Office?     @relation(fields: [officeId], references: [id])
  officeId                 String?

  // User's own location fields (Address)
  countryId                String?
  country                  Location?   @relation("UserCountry", fields: [countryId], references: [id])
  stateId                  String?
  state                    Location?   @relation("UserState", fields: [stateId], references: [id])
  districtId               String?
  district                 Location?   @relation("UserDistrict", fields: [districtId], references: [id])

  // Assigned Locations for Visibility Boundary
  assignedLocations        UserLocationAssignment[]

  // Supervisor self-relation
  supervisor               User?       @relation("UserSupervisor", fields: [supervisorId], references: [id])
  supervisorId             String?
  subordinates             User[]      @relation("UserSupervisor")

  // Target relations
  targetSettings           TargetSetting[]
  violations               TargetViolation[]

  // Devices
  devices                  Device[]

  // Audit logs relation
  auditLogs                AuditLog[]
  performedLeadActivities  LeadActivity[] @relation("LeadActivityPerformedBy")
  requestedLeadStageApprovals LeadStageApproval[] @relation("LeadStageApprovalRequestedBy")
  assignedLeadStageApprovals LeadStageApproval[] @relation("LeadStageApprovalAssignedTo")
  approvedLeadStageApprovals LeadStageApproval[] @relation("LeadStageApprovalApprovedBy")
  rosterEntries            RosterEntry[]
  followUps                FollowUp[]
  createdLeads             Lead[]       @relation("LeadCreatedBy")
  assignedLeads            Lead[]       @relation("LeadAssignedTo")
  closedLeads              Lead[]       @relation("LeadClosedBy")

  createdHolidays          Holiday[]    @relation("HolidayCreatedBy")
  updatedHolidays          Holiday[]    @relation("HolidayUpdatedBy")
  createdCountries         Country[]    @relation("CountryCreatedBy")
  updatedCountries         Country[]    @relation("CountryUpdatedBy")
  createdLocationLevels    LocationLevel[] @relation("LocationLevelCreatedBy")
  updatedLocationLevels    LocationLevel[] @relation("LocationLevelUpdatedBy")
  createdLOBReasons        LOBReason[]  @relation("LOBReasonCreatedBy")
  updatedLOBReasons        LOBReason[]  @relation("LOBReasonUpdatedBy")
  createdReportTypes       ReportType[] @relation("ReportTypeCreatedBy")
  updatedReportTypes       ReportType[] @relation("ReportTypeUpdatedBy")
  createdReports           Report[]     @relation("ReportCreatedBy")
  generatedReportLogs      ReportLog[]  @relation("ReportLogGeneratedBy")
  createdImportJobs        ImportJob[]  @relation("ImportJobCreatedBy")
  receivedInvites          Invite[]     @relation("InviteUser")
  createdInvites           Invite[]     @relation("InviteCreatedBy")

  createdAt                DateTime    @default(now())
  updatedAt                DateTime    @updatedAt

  @@index([workspaceId])
  @@index([roleId])
  @@index([departmentId])
  @@index([officeId])
  @@index([supervisorId])
  @@index([workspaceId, deletedAt, createdAt(sort: Desc)])
  @@index([workspaceId, roleId, deletedAt])
  @@index([workspaceId, supervisorId, deletedAt])
  @@map("users")
}

model Invite {
  id          String    @id @default(cuid())
  userId      String
  workspaceId String
  tokenHash   String    @unique
  expiresAt   DateTime
  usedAt      DateTime?
  createdBy   String
  createdAt   DateTime  @default(now())

  user        User      @relation("InviteUser", fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  creator     User      @relation("InviteCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)

  @@index([workspaceId, userId])
  @@index([workspaceId, createdBy])
  @@index([workspaceId, expiresAt])
  @@index([workspaceId, usedAt])
  @@map("invites")
}

model FollowUp {
  id          String   @id @default(cuid())
  leadId      String
  userId      String
  workspaceId String

  type        String
  description String?
  status      String   @default("PENDING")

  scheduledAt DateTime
  completedAt DateTime?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  lead        Lead            @relation(fields: [leadId], references: [id], onDelete: Cascade)
  images      FollowUpImage[]

  @@index([workspaceId, userId, scheduledAt])
  @@index([workspaceId, status, scheduledAt])
  @@index([leadId])
  @@index([workspaceId, userId, status, scheduledAt(sort: Desc)])
  @@map("follow_ups")
}

model FollowUpImage {
  id         String   @id @default(cuid())
  followUpId String
  url        String

  createdAt  DateTime @default(now())

  followUp   FollowUp @relation(fields: [followUpId], references: [id], onDelete: Cascade)

  @@index([followUpId])
  @@map("follow_up_images")
}

model RosterEntry {
  id         String       @id @default(uuid())
  userId     String
  rosterType RosterType
  name       String
  startDate  DateTime
  endDate    DateTime?
  shiftSession   ShiftSession?
  shiftStartTime String?
  shiftEndTime   String?
  status     RosterStatus @default(ACTIVE)
  createdBy  String?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  deletedAt  DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([startDate])
  @@index([status])
  @@map("roster_entries")
}

model AuditLog {
  id          String   @id @default(cuid())
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  workspaceId String?
  action      String   // e.g., "USER_LOGIN", "USER_CREATED", "SETTINGS_UPDATED"
  entityType  String?  // e.g., "User", "Workspace"
  entityId    String?
  details     Json?    // Store old/new values or extra metadata
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([workspaceId])
  @@index([action])
  @@index([workspaceId, createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
  @@index([workspaceId, action, createdAt(sort: Desc)])
  @@map("audit_logs")
}

model Device {
  id         String   @id @default(cuid())
  deviceId   String
  os         String?
  browser    String?
  deviceType String?
  ipAddress  String?
  lastActive DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userId, deviceId])
  @@map("devices")
}

enum HolidaySource {
  MANUAL
  API
  AI
  GOOGLE
}

enum HolidayStatus {
  ACTIVE
  INACTIVE
}

model Holiday {
  id             String        @id @default(uuid())
  workspaceId    String
  name           String
  holidayDate    DateTime      @db.Date
  countryId      String?
  stateId        String?
  districtId     String?
  isRecurring    Boolean       @default(false)
  recurrenceRule String?
  source         HolidaySource @default(MANUAL)
  status         HolidayStatus @default(ACTIVE)

  createdById    String?
  updatedById    String?

  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  workspace      Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  country        Location?     @relation("HolidayCountry", fields: [countryId], references: [id])
  state          Location?     @relation("HolidayState", fields: [stateId], references: [id])
  district       Location?     @relation("HolidayDistrict", fields: [districtId], references: [id])

  createdBy      User?         @relation("HolidayCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy      User?         @relation("HolidayUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([countryId, stateId, districtId])
  @@index([holidayDate])
  @@map("holidays")
}

model HolidaySyncLog {
  id          String        @id @default(uuid())
  workspaceId String
  source      HolidaySource
  status      String
  message     String?       @db.Text
  syncedAt    DateTime      @default(now())

  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([syncedAt])
  @@map("holiday_sync_logs")
}

model ReportType {
  id             String             @id @default(uuid())
  workspaceId    String
  name           String
  module         ReportModule
  baseDataSource ReportBaseDataSource
  description    String?
  allowedFilters Json               @default("[]")
  status         ReportTypeStatus   @default(ACTIVE)
  createdById    String?
  updatedById    String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  deletedAt      DateTime?

  workspace      Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy      User?              @relation("ReportTypeCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy      User?              @relation("ReportTypeUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  logs           ReportLog[]
  reports        Report[]

  @@index([workspaceId])
  @@index([status])
  @@index([module])
  @@index([workspaceId, status, module, createdAt(sort: Desc)])
  @@map("report_types")
}

model ReportLog {
  id            String     @id @default(uuid())
  workspaceId   String
  reportTypeId  String?
  reportId      String?
  generatedById String?
  action        String?
  filters       Json       @default("[]")
  resultCount   Int        @default(0)
  meta          Json       @default("{}")
  createdAt     DateTime   @default(now())

  workspace     Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  reportType    ReportType? @relation(fields: [reportTypeId], references: [id], onDelete: SetNull)
  report        Report?     @relation("ReportInstanceLogs", fields: [reportId], references: [id], onDelete: Cascade)
  generatedBy   User?      @relation("ReportLogGeneratedBy", fields: [generatedById], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([reportTypeId])
  @@index([reportId])
  @@index([generatedById])
  @@index([action])
  @@index([workspaceId, createdAt(sort: Desc)])
  @@map("report_logs")
}

model Report {
  id               String        @id @default(uuid())
  workspaceId      String
  reportName       String
  reportTypeId     String
  reportDate       DateTime      @db.Date
  isActive         Boolean       @default(true)
  isGenerated      Boolean       @default(false)
  generatedFileUrl String?
  generatedAt      DateTime?
  createdById      String
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  deletedAt        DateTime?

  workspace        Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  reportType       ReportType    @relation(fields: [reportTypeId], references: [id], onDelete: Restrict)
  createdBy        User          @relation("ReportCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  filters          ReportFilter[]
  logs             ReportLog[]   @relation("ReportInstanceLogs")

  @@index([workspaceId])
  @@index([reportTypeId])
  @@index([createdById])
  @@index([isActive])
  @@index([isGenerated])
  @@index([reportDate])
  @@index([workspaceId, deletedAt, createdAt(sort: Desc)])
  @@index([workspaceId, reportTypeId, reportDate])
  @@map("reports")
}

model ReportFilter {
  id          String   @id @default(uuid())
  reportId    String
  filterKey   String
  filterValue String   @db.Text
  createdAt   DateTime @default(now())

  report      Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([reportId])
  @@index([filterKey])
  @@map("report_filters")
}

enum ImportJobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model ImportJob {
  id              String          @id @default(uuid())
  workspaceId     String
  fileName        String
  totalRows       Int?            @default(0)
  processedRows   Int             @default(0)
  successCount    Int             @default(0)
  failedCount     Int             @default(0)
  status          ImportJobStatus @default(PENDING)
  errorFileUrl    String?         @db.Text
  createdById     String?

  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  workspace       Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy       User?           @relation("ImportJobCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([status])
  @@index([workspaceId, status])
  @@map("import_jobs")
}
