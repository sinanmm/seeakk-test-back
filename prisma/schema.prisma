model User {
  id                       String      @id @default(cuid())
  name                     String?
  username                 String?     @unique
  email                    String      @unique
  password                 String?
  phone                    String?
  googleId                 String?     @unique
  isOnboarded              Boolean     @default(false)
  isActive                 Boolean     @default(true)
  isEmailVerified          Boolean     @default(false)
  isLocked                 Boolean     @default(false) // Target compliance lock
  verificationToken        String?
  verificationTokenExpires DateTime?
  invitationToken          String?
  invitationExpires        DateTime?
  deletedAt                DateTime?

  // Role relation
  role                     Role?       @relation(fields: [roleId], references: [id])
  roleId                   String?

  // Workspace relation
  workspace                Workspace?  @relation("WorkspaceMembers", fields: [workspaceId], references: [id])
  workspaceId              String?
  ownedWorkspace           Workspace?  @relation("WorkspaceOwner")

  // Department relation
  department               Department? @relation(fields: [departmentId], references: [id])
  departmentId             String?

  // Office relation
  office                   Office?     @relation(fields: [officeId], references: [id])
  officeId                 String?

  // User's own location fields (Address)
  countryId                String?
  country                  Location?   @relation("UserCountry", fields: [countryId], references: [id])
  stateId                  String?
  state                    Location?   @relation("UserState", fields: [stateId], references: [id])
  districtId               String?
  district                 Location?   @relation("UserDistrict", fields: [districtId], references: [id])

  // Assigned Locations for Visibility Boundary
  assignedLocations        UserLocationAssignment[]

  // Supervisor self-relation
  supervisor               User?       @relation("UserSupervisor", fields: [supervisorId], references: [id])
  supervisorId             String?
  subordinates             User[]      @relation("UserSupervisor")

  // Target relations
  assignedTargetCycleId    String?
  assignedTargetCycle      TargetCycle?      @relation("UserAssignedTargetCycle", fields: [assignedTargetCycleId], references: [id], onDelete: SetNull)
  targetLockedAt           DateTime?
  targetLockReason         String?
  targetSettings           TargetSetting[]
  targetAssignments        TargetAssignment[]
  targetLockLogs           TargetLockLog[]
  targetUnlockLogs         TargetUnlockLog[] @relation("TargetUnlockUser")
  targetUnlockActions      TargetUnlockLog[] @relation("TargetUnlockActor")
  violations               TargetViolation[]

  // Devices
  devices                  Device[]

  // Password reset tokens (self-service forgot password)
  passwordResetTokens      PasswordResetToken[]

  // Audit logs relation
  auditLogs                AuditLog[]
  performedLeadActivities  LeadActivity[] @relation("LeadActivityPerformedBy")
  requestedLeadStageApprovals LeadStageApproval[] @relation("LeadStageApprovalRequestedBy")
  assignedLeadStageApprovals LeadStageApproval[] @relation("LeadStageApprovalAssignedTo")
  approvedLeadStageApprovals LeadStageApproval[] @relation("LeadStageApprovalApprovedBy")

  leadTotalAmountHistory      LeadTotalAmountHistory[]
  advancePaymentsRequested    AdvancePayment[] @relation("AdvanceRequestedBy")
  advancePaymentsApproved     AdvancePayment[] @relation("AdvanceApprovedBy")
  advancePaymentsRejected     AdvancePayment[] @relation("AdvanceRejectedBy")

  rosterEntries            RosterEntry[]
  attendanceRecords        AttendanceRecord[]
  attendanceSchedule       AttendanceSchedule?
  attendanceApplyType      String                 @default("FROM_ANYWHERE") // FROM_OFFICE, FROM_ANYWHERE
  attendanceOfficeLocationId String?
  attendanceOfficeLocation AttendanceOfficeLocation? @relation(fields: [attendanceOfficeLocationId], references: [id], onDelete: SetNull)
  attendanceUserSetting  AttendanceUserSetting?
  followUps                FollowUp[]
  snoozedActivities        FollowupActivityLog[]
  createdLeads             Lead[]       @relation("LeadCreatedBy")
  assignedLeads            Lead[]       @relation("LeadAssignedTo")
  closedLeads              Lead[]       @relation("LeadClosedBy")
  approvedLeadsRevenue     Lead[]       @relation("LeadRevenueApprovedBy")
  revenueTransactions      RevenueTransaction[] @relation("RevenueTransactionUser")
  approvedRevenueTransactions RevenueTransaction[] @relation("RevenueTransactionApprovedBy")

  createdHolidays          Holiday[]    @relation("HolidayCreatedBy")
  updatedHolidays          Holiday[]    @relation("HolidayUpdatedBy")
  createdCountries         Country[]    @relation("CountryCreatedBy")
  updatedCountries         Country[]    @relation("CountryUpdatedBy")
  createdLocationLevels    LocationLevel[] @relation("LocationLevelCreatedBy")
  updatedLocationLevels    LocationLevel[] @relation("LocationLevelUpdatedBy")
  createdLOBReasons        LOBReason[]  @relation("LOBReasonCreatedBy")
  updatedLOBReasons        LOBReason[]  @relation("LOBReasonUpdatedBy")
  createdReportTypes       ReportType[] @relation("ReportTypeCreatedBy")
  updatedReportTypes       ReportType[] @relation("ReportTypeUpdatedBy")
  createdReports           Report[]     @relation("ReportCreatedBy")
  generatedReportLogs      ReportLog[]  @relation("ReportLogGeneratedBy")
  createdImportJobs        ImportJob[]  @relation("ImportJobCreatedBy")
  receivedInvites          Invite[]     @relation("InviteUser")
  createdInvites           Invite[]     @relation("InviteCreatedBy")
  temporaryBulkExtensionAccesses TemporaryBulkExtensionAccess[] @relation("BulkExtensionUser")
  grantedBulkExtensionAccesses TemporaryBulkExtensionAccess[] @relation("BulkExtensionGrantedBy")
  bulkFollowUpExtensions   BulkFollowUpExtension[]

  createdAt                DateTime    @default(now())
  updatedAt                DateTime    @updatedAt

  @@index([workspaceId])
  @@index([roleId])
  @@index([departmentId])
  @@index([officeId])
  @@index([supervisorId])
  @@index([workspaceId, deletedAt, createdAt(sort: Desc)])
  @@index([workspaceId, roleId, deletedAt])
  @@index([workspaceId, supervisorId, deletedAt])
  @@map("users")
}

