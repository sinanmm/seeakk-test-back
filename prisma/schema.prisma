generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
  binaryTargets   = ["native", "darwin-arm64", "debian-openssl-3.0.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum TargetSettingCycle {
  MONTHLY
  QUARTERLY
  YEARLY
  CUSTOM

  @@map("TargetCycle")
}

enum ViolationType {
  DAILY
  MONTHLY
}

enum TargetCycleType {
  WEEKLY
  MONTHLY
  SEMI_ANNUAL
  MANUAL
}

enum TargetMetricType {
  LEADS
  REVENUE
  FOLLOW_UP
  PRODUCTS
}

enum LocationType {
  COUNTRY
  STATE
  DISTRICT
  CITY
  WARD
  CONSTITUENCY
  OFFICE
}

enum RoleStatus {
  ACTIVE
  INACTIVE
}

model Role {
  id           String     @id @default(uuid())
  workspaceId  String
  name         String
  status       RoleStatus @default(ACTIVE)
  description  String?
  isSystemRole Boolean    @default(false)

  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace               Workspace                @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  permissions             RolePermission[]
  users                   User[]
  dashboardPipelineShares DashboardPipelineShare[]

  @@unique([workspaceId, name])
  @@index([workspaceId])
  @@index([workspaceId, status])
  @@map("roles")
}

model Permission {
  id          String  @id @default(uuid())
  key         String  @unique
  group       String
  description String?

  createdAt DateTime @default(now())

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id])
  permission Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model Workspace {
  id                             String                         @id @default(cuid())
  companyName                    String
  logoUrl                        String?                        @db.Text
  employeeCount                  String
  timeZone                       String                         @default("UTC")
  language                       String                         @default("en-US")
  currencyLocale                 String                         @default("USD")
  loadSampleData                 Boolean                        @default(false)
  weeklyOffDays                  Int[]                          @default([0])
  weeklyOffColor                 String                         @default("#cbd5e1")
  owner                          User                           @relation("WorkspaceOwner", fields: [ownerId], references: [id])
  ownerId                        String                         @unique
  users                          User[]                         @relation("WorkspaceMembers")
  roles                          Role[]
  departments                    Department[]
  leadSources                    LeadSource[]
  products                       Product[]
  leadStages                     LeadStage[]
  stageRules                     StageRule[]
  targetCycles                   TargetCycle[]
  leadLifeCycles                 LeadLifeCycle[]
  leadDynamicFields              LeadDynamicField[]
  leads                          Lead[]
  leadProducts                   LeadProduct[]
  leadStars                      LeadStar[]
  leadActivities                 LeadActivity[]
  leadStageApprovals             LeadStageApproval[]
  holidays                       Holiday[]
  holidaySyncLogs                HolidaySyncLog[]
  countries                      Country[]
  locationLevels                 LocationLevel[]
  lobReasons                     LOBReason[]
  reportTypes                    ReportType[]
  reports                        Report[]
  reportLogs                     ReportLog[]
  sheets                         Sheet[]
  sheetVersions                  SheetVersion[]
  importJobs                     ImportJob[]
  invites                        Invite[]
  stageHistory                   LeadStageHistory[]
  revenueTransactions            RevenueTransaction[]
  followUpExtensionReasons       FollowUpExtensionReason[]
  followUpSettings               FollowUpSettings?
  temporaryBulkExtensionAccesses TemporaryBulkExtensionAccess[]
  bulkFollowUpExtensions         BulkFollowUpExtension[]
  advancePayments                AdvancePayment[]
  fieldHighlightConfigs          FieldHighlightConfig[]
  salaryRecords                  SalaryRecord[]
  salaryApprovalStages           SalaryApprovalStage[]
  salarySetting                  SalarySetting?
  substages                      LeadSubstage[]
  callSessions                   LeadCallSession[]
  callOutcomes                   LeadCallOutcome[]
  dashboardPipelineSections      DashboardPipelineSection[]
  dashboardPipelines             DashboardPipeline[]
  dashboardPipelineShares        DashboardPipelineShare[]
  dashboardPipelineAudits        DashboardPipelineAudit[]
  metaConnections                MetaConnection[]
  metaPageConnections            MetaPageConnection[]
  metaLeadForms                  MetaLeadForm[]
  metaLeadImports                MetaLeadImport[]
  telephonySetting               TelephonySetting?
  telephonyProviderConfigs       TelephonyProviderConfig[]
  telephonyUserMappings          TelephonyUserMapping[]
  whatsAppTemplates              WhatsAppTemplate[]
  dashboardLayoutPreferences     DashboardLayoutPreference[]
  automationWorkflows            AutomationWorkflow[]
  automationExecutions           AutomationExecution[]

  // Billing & Subscription Foundation
  billingStatus                  String?
  approvedUserLimit              Int?
  accessFrom                     DateTime?
  accessUntil                    DateTime?
  lockedAt                       DateTime?
  lockReason                     String?
  suspendReason                  String?
  paymentRequests                PaymentRequest[]
  paymentSubmissions             PaymentSubmission[]
  verifiedPayments               VerifiedPayment[]
  graceRecords                   GraceRecord[]

  createdAt                      DateTime                       @default(now())
  updatedAt                      DateTime                       @updatedAt
  LeadRemark                     LeadRemark[]

  @@map("workspaces")
}

enum DepartmentStatus {
  ACTIVE
  INACTIVE
}

enum LeadSourceStatus {
  ACTIVE
  INACTIVE
}

enum ProductStatus {
  ACTIVE
  INACTIVE
}

enum StageStatus {
  ACTIVE
  INACTIVE
}

enum LeadClosureType {
  WON
  LOST
  CANCELLED
}

enum LeadExpiryAction {
  AUTO_LOB
  WARN_AND_CHOOSE
}

enum LeadApprovalStatus {
  PENDING
  APPROVED
  DENIED
}

enum LeadApprovalState {
  NONE
  PENDING
}

enum ReportTypeStatus {
  ACTIVE
  INACTIVE
}

enum LOBReasonStatus {
  ACTIVE
  INACTIVE
}

enum ReportBaseDataSource {
  LEADS
  USERS
  FOLLOWUPS
  ACTIVITY
}

enum ReportModule {
  LEADS
  USERS
  REPORTS
  TARGETS
  FOLLOWUPS
  ACTIVITY
}

enum InputType {
  TEXT
  TEXTAREA
  RADIO
  SELECT
}

enum RuleStatus {
  ACTIVE
  INACTIVE
}

enum RosterType {
  HOLIDAY
  WEEKLY_OFF
  SHIFT
  SPECIAL_WORKING_DAY
}

enum RosterStatus {
  ACTIVE
  INACTIVE
}

enum ShiftSession {
  DAY
  NIGHT
}

model Department {
  id          String           @id @default(uuid())
  name        String
  description String?
  status      DepartmentStatus @default(ACTIVE)

  workspace   Workspace? @relation(fields: [workspaceId], references: [id])
  workspaceId String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  users                   User[]
  dashboardPipelineShares DashboardPipelineShare[]

  @@unique([name, workspaceId])
  @@index([workspaceId])
  @@index([name])
  @@index([status])
  @@index([createdAt])
  @@index([workspaceId, deletedAt, status, createdAt(sort: Desc)])
  @@map("departments")
}

model LeadSource {
  id          String           @id @default(uuid())
  workspaceId String
  name        String
  status      LeadSourceStatus @default(ACTIVE)
  createdBy   String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  deletedAt   DateTime?
  workspace   Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  leads       Lead[]
  metaLeadForms MetaLeadForm[]

  // Duplicate stage names are allowed by product requirement.
  @@index([workspaceId])
  @@index([name])
  @@index([status])
  @@index([workspaceId, status, createdAt(sort: Desc)])
  @@map("lead_sources")
}

model LeadStage {
  id                  String               @id @default(uuid())
  workspaceId         String
  name                String
  stageShortForm      String?
  showInCalendar      Boolean              @default(true)
  color               String               @default("#10b981")
  isApprovalRequired  Boolean              @default(false)
  isLOB               Boolean              @default(false)
  isClosed            Boolean              @default(false)
  order               Int
  status              StageStatus          @default(ACTIVE)
  createdBy           String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  deletedAt           DateTime?
  workspace           Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  rules               StageRule[]
  leads               Lead[]
  targetCycles        TargetCycle[]
  approvalsFrom       LeadStageApproval[]  @relation("LeadStageApprovalFromStage")
  approvalsTo         LeadStageApproval[]  @relation("LeadStageApprovalToStage")
  revenueTransactions RevenueTransaction[]
  stageTargets        TargetStageTarget[]
  substages           LeadSubstage[]
  callOutcomesFrom    LeadCallOutcome[]    @relation("CallOutcomePrevStage")
  callOutcomesTo      LeadCallOutcome[]    @relation("CallOutcomeTargetStage")
  metaLeadForms       MetaLeadForm[]

  @@unique([workspaceId, name])
  @@unique([workspaceId, stageShortForm])
  @@index([workspaceId])
  @@index([name])
  @@index([status])
  @@index([order])
  @@index([workspaceId, status, order])
  @@map("lead_stages")
}

model StageRule {
  id                String     @id @default(uuid())
  workspaceId       String
  name              String     @default("Untitled Rule")
  inputType         InputType  @default(TEXT)
  /// JSON string[] â€” choices for RADIO / SELECT
  options           Json?
  sortOrder         Int        @default(1)
  required          Boolean    @default(false)
  minCharacters     Int?
  // Legacy columns kept for backward compatibility to avoid destructive schema pushes.
  legacyField       String?    @map("field")
  legacyCondition   String?    @map("condition")
  legacyValue       String?    @map("value")
  legacyIsMandatory Boolean?   @map("isMandatory")
  status            RuleStatus @default(ACTIVE)
  stageId           String?
  createdBy         String?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @default(now()) @updatedAt
  deletedAt         DateTime?

  workspace  Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  stage      LeadStage?       @relation(fields: [stageId], references: [id], onDelete: SetNull)
  leadInputs LeadStageInput[]

  @@unique([workspaceId, name])
  @@index([workspaceId])
  @@index([name])
  @@index([status])
  @@index([sortOrder])
  @@index([stageId])
  @@index([workspaceId, status, sortOrder])
  @@map("stage_rules")
}

model LeadStageInput {
  id        String   @id @default(uuid())
  leadId    String
  ruleId    String
  value     String
  createdAt DateTime @default(now())

  rule StageRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@index([ruleId])
  @@map("lead_stage_inputs")
}

model Office {
  id          String   @id @default(cuid())
  name        String
  address     String?
  countryId   String?
  stateId     String?
  districtId  String?
  country     String?
  state       String?
  district    String?
  city        String?
  isActive    Boolean  @default(true)
  createdBy   String?
  workspaceId String
  users                   User[]
  holidays                HolidayOffice[]
  dashboardPipelineShares DashboardPipelineShare[]
  createdAt               DateTime                 @default(now())
  updatedAt   DateTime @updatedAt

  @@index([workspaceId])
  @@index([name])
  @@index([countryId])
  @@index([stateId])
  @@index([districtId])
  @@map("offices")
}

model Country {
  id          String    @id @default(uuid())
  workspaceId String
  name        String
  code        String?
  isActive    Boolean   @default(true)
  createdById String?
  updatedById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  workspace Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User?           @relation("CountryCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy User?           @relation("CountryUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  levels    LocationLevel[]
  locations Location[]

  @@index([workspaceId])
  @@index([workspaceId, isActive, createdAt(sort: Desc)])
  @@map("countries")
}

model LocationLevel {
  id          String   @id @default(uuid())
  workspaceId String
  countryId   String
  levelName   String
  levelOrder  Int
  isActive    Boolean  @default(true)
  createdById String?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  country   Country    @relation(fields: [countryId], references: [id], onDelete: Cascade)
  createdBy User?      @relation("LocationLevelCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy User?      @relation("LocationLevelUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  locations Location[]

  @@unique([countryId, levelOrder])
  @@index([workspaceId])
  @@index([countryId, isActive, levelOrder])
  @@map("location_levels")
}

model Location {
  id          String       @id @default(cuid())
  name        String
  type        LocationType
  workspaceId String
  countryId   String?
  levelId     String?
  isActive    Boolean      @default(true)
  createdById String?
  updatedById String?
  deletedAt   DateTime?

  parentId String?
  parent   Location?      @relation("LocationHierarchy", fields: [parentId], references: [id])
  children Location[]     @relation("LocationHierarchy")
  country  Country?       @relation(fields: [countryId], references: [id], onDelete: SetNull)
  level    LocationLevel? @relation(fields: [levelId], references: [id], onDelete: SetNull)

  assignedUsers UserLocationAssignment[]

  // Potential address relations for users (where they live)
  usersAtCountry  User[] @relation("UserCountry")
  usersAtState    User[] @relation("UserState")
  usersAtDistrict User[] @relation("UserDistrict")

  holidaysAtCountry  Holiday[] @relation("HolidayCountry")
  holidaysAtState    Holiday[] @relation("HolidayState")
  holidaysAtDistrict Holiday[] @relation("HolidayDistrict")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workspaceId])
  @@index([parentId])
  @@index([countryId])
  @@index([levelId])
  @@index([workspaceId, countryId, levelId, isActive])
  @@map("locations")
}

model UserLocationAssignment {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  locationId String
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  workspaceId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, locationId])
  @@index([workspaceId])
  @@map("user_location_assignments")
}

model TargetType {
  id          String          @id @default(cuid())
  name        String          @unique // e.g., "Revenue", "Leads Generated"
  description String?
  workspaceId String? // Optional: Global types or workspace-specific
  settings    TargetSetting[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@map("target_types")
}

model TargetCycle {
  id          String  @id @default(cuid())
  name        String
  workspaceId String
  description String?

  totalDays Int    @default(30)
  status    String @default("ACTIVE")

  targetType     TargetCycleType  @default(MONTHLY)
  targetMetric   TargetMetricType @default(LEADS)
  leadStageId    String?
  startDate      DateTime         @default(now())
  endDate        DateTime?
  numberOfMonths Int?
  lockingEnabled Boolean          @default(true)

  createdBy String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  workspace     Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  leadStage     LeadStage?          @relation(fields: [leadStageId], references: [id], onDelete: SetNull)
  ranges        TargetCycleRange[]
  periods       TargetCyclePeriod[]
  targets       TargetSetting[]
  assignments   TargetAssignment[]
  assignedUsers User[]              @relation("UserAssignedTargetCycle")

  @@unique([name, workspaceId])
  @@index([workspaceId])
  @@index([workspaceId, status])
  @@index([leadStageId])
  @@map("target_cycles")
}

model TargetCyclePeriod {
  id            String   @id @default(cuid())
  targetCycleId String
  label         String
  periodIndex   Int
  targetCount   Int      @default(0)
  startDate     DateTime
  endDate       DateTime
  lockingDate   DateTime

  allowSelfUnlock           Boolean @default(false)
  selfUnlockGraceDays       Int?
  lockSupervisorOnRefailure Boolean @default(false)
  enableSupervisorLockChain Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  targetCycle  TargetCycle            @relation(fields: [targetCycleId], references: [id], onDelete: Cascade)
  performances TargetPerformanceLog[]
  metrics      TargetPeriodMetric[]

  @@index([targetCycleId])
  @@index([lockingDate])
  @@map("target_cycle_periods")
}

model TargetAssignment {
  id                   String    @id @default(cuid())
  userId               String
  targetCycleId        String
  workspaceId          String
  supervisorId         String?
  isActive             Boolean   @default(true)
  assignedById         String?
  graceUntil           DateTime?
  isLockExempt         Boolean   @default(false)
  exemptUntilPeriodEnd DateTime?
  exemptPeriodId       String?
  lastUnlockDate       DateTime?
  lastUnlockedBy       String?
  assignedAt           DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  user         User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  targetCycle  TargetCycle            @relation(fields: [targetCycleId], references: [id], onDelete: Cascade)
  performances TargetPerformanceLog[]
  lockLogs     TargetLockLog[]
  unlockLogs   TargetUnlockLog[]

  @@unique([userId, targetCycleId])
  @@index([workspaceId, isActive])
  @@index([targetCycleId])
  @@index([exemptPeriodId])
  @@map("target_assignments")
}

model TargetPerformanceLog {
  id                   String    @id @default(cuid())
  assignmentId         String
  periodId             String
  targetCount          Int
  achievedCount        Int       @default(0)
  achievedRevenue      Float     @default(0)
  completionPercentage Float     @default(0)
  status               String    @default("PENDING")
  evaluatedAt          DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  // Extended fields for multi-metric support
  metricType    String?
  leadStageId   String?
  targetValue   Float?
  achievedValue Float?
  followupCount Int     @default(0)
  revenueAmount Float   @default(0)

  assignment TargetAssignment  @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  period     TargetCyclePeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)

  @@unique([assignmentId, periodId])
  @@index([periodId])
  @@map("target_performance_logs")
}

model TargetPeriodMetric {
  id                   String   @id @default(cuid())
  periodId             String
  metricType           String // "LEADS", "REVENUE", "FOLLOW_UP", "PRODUCTS"
  targetValue          Float    @default(0)
  achievedValue        Float    @default(0)
  completionPercentage Float    @default(0)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  period         TargetCyclePeriod     @relation(fields: [periodId], references: [id], onDelete: Cascade)
  stageTargets   TargetStageTarget[]
  productTargets TargetProductTarget[]

  @@index([periodId])
  @@map("target_period_metrics")
}

model TargetStageTarget {
  id                   String   @id @default(cuid())
  periodMetricId       String
  leadStageId          String
  targetValue          Int
  achievedValue        Int      @default(0)
  completionPercentage Float    @default(0)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  periodMetric TargetPeriodMetric @relation(fields: [periodMetricId], references: [id], onDelete: Cascade)
  leadStage    LeadStage          @relation(fields: [leadStageId], references: [id], onDelete: Cascade)

  @@index([periodMetricId])
  @@index([leadStageId])
  @@map("target_stage_targets")
}

model TargetProductTarget {
  id                   String   @id @default(cuid())
  periodMetricId       String
  productId            String
  targetValue          Int
  achievedValue        Int      @default(0)
  completionPercentage Float    @default(0)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  periodMetric TargetPeriodMetric @relation(fields: [periodMetricId], references: [id], onDelete: Cascade)
  product      Product            @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([periodMetricId])
  @@index([productId])
  @@map("target_product_targets")
}

model TargetFollowupLog {
  id          String   @id @default(cuid())
  followUpId  String   @unique
  userId      String
  workspaceId String
  completedAt DateTime
  status      String
  createdAt   DateTime @default(now())

  @@index([userId, completedAt])
  @@index([workspaceId])
  @@map("target_followup_logs")
}

model TargetLockLog {
  id             String    @id @default(cuid())
  userId         String
  workspaceId    String
  assignmentId   String?
  periodId       String?
  lockPeriodId   String?
  reason         String
  lockedAt       DateTime  @default(now())
  lockedBySystem Boolean   @default(true)
  isInvalidLock  Boolean   @default(false)
  invalidatedAt  DateTime?

  selfUnlockAllowed         Boolean   @default(false)
  selfUnlockUsed            Boolean   @default(false)
  selfUnlockedAt            DateTime?
  selfUnlockGraceDays       Int?
  reEvaluationAt            DateTime?
  reEvaluatedAt             DateTime?
  reEvaluationPassed        Boolean?
  originalLockId            String?
  reLockCount               Int       @default(0)
  escalationLevel           Int       @default(0)
  originatingUserId         String?
  originatingLockId         String?
  lockSupervisorOnRefailure Boolean   @default(false)
  enableSupervisorLockChain Boolean   @default(false)

  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignment TargetAssignment? @relation(fields: [assignmentId], references: [id], onDelete: SetNull)

  @@index([userId, lockedAt])
  @@index([workspaceId])
  @@index([lockPeriodId])
  @@index([reEvaluationAt])
  @@index([workspaceId, reEvaluationAt])
  @@map("target_lock_logs")
}

model TargetUnlockLog {
  id                   String    @id @default(cuid())
  userId               String
  workspaceId          String
  assignmentId         String?
  unlockedById         String
  reason               String?
  exemptPeriodId       String?
  exemptUntilPeriodEnd DateTime?
  unlockedAt           DateTime  @default(now())

  isSelfUnlock    Boolean   @default(false)
  graceUntil      DateTime?
  targetLockLogId String?

  user       User              @relation("TargetUnlockUser", fields: [userId], references: [id], onDelete: Cascade)
  unlockedBy User              @relation("TargetUnlockActor", fields: [unlockedById], references: [id], onDelete: Cascade)
  assignment TargetAssignment? @relation(fields: [assignmentId], references: [id], onDelete: SetNull)

  @@index([userId, unlockedAt])
  @@index([workspaceId])
  @@map("target_unlock_logs")
}

model TargetCycleRange {
  id            String @id @default(cuid())
  targetCycleId String

  startDay Int
  endDay   Int

  createdAt DateTime @default(now())

  targetCycle TargetCycle @relation(fields: [targetCycleId], references: [id], onDelete: Cascade)

  @@index([targetCycleId])
  @@map("target_cycle_ranges")
}

model LeadLifeCycle {
  id        String  @id @default(cuid())
  name      String
  isDefault Boolean @default(false)

  workspaceId String

  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace   Workspace                 @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  transitions LeadLifeCycleTransition[]
  leads       Lead[]

  @@unique([name, workspaceId])
  @@index([workspaceId])
  @@index([workspaceId, isDefault, name])
  @@map("lead_life_cycles")
}

model Lead {
  id                         String            @id @default(cuid())
  name                       String
  email                      String?
  phone                      String?
  companyName                String?
  address                    String?
  remarks                    String?
  profileImageUrl            String?           @db.Text
  profileImageThumbnail      String?           @db.Text
  profileImageUploadedAt     DateTime?
  profileImageUploadedById   String?
  expectedRevenue            Float?
  generatedRevenue           Float             @default(0)
  assignedToId               String?
  stageId                    String?
  lifecycleId                String?
  sourceId                   String?
  nextFollowUpAt             DateTime?
  stageEnteredAt             DateTime?
  stageExpiresAt             DateTime?
  slaAction                  LeadExpiryAction?
  slaWarningDays             Int?
  approvalState              LeadApprovalState @default(NONE)
  pendingApprovalToStageId   String?
  pendingApprovalRequestedAt DateTime?
  isClosed                   Boolean           @default(false)
  isLOB                      Boolean           @default(false)
  closedAt                   DateTime?
  closedById                 String?
  closureType                LeadClosureType?
  earnedRevenue              Float?
  revenueApprovedById        String?
  revenueApprovedAt          DateTime?
  workspaceId                String
  createdById                String
  deletedAt                  DateTime?
  createdAt                  DateTime          @default(now())
  updatedAt                  DateTime          @updatedAt

  substageId                 String?
  assignedTo          User?                @relation("LeadAssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)
  stage               LeadStage?           @relation(fields: [stageId], references: [id], onDelete: SetNull)
  substage            LeadSubstage?        @relation(fields: [substageId], references: [id], onDelete: SetNull)
  lifecycle           LeadLifeCycle?       @relation(fields: [lifecycleId], references: [id], onDelete: SetNull)
  source              LeadSource?          @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  createdBy           User                 @relation("LeadCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  closedBy            User?                @relation("LeadClosedBy", fields: [closedById], references: [id], onDelete: SetNull)
  revenueApprovedBy   User?                @relation("LeadRevenueApprovedBy", fields: [revenueApprovedById], references: [id], onDelete: SetNull)
  workspace           Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  followUps           FollowUp[]
  lobLogs             LeadLOBLog[]
  activities          LeadActivity[]
  stageApprovals      LeadStageApproval[]
  stageHistory        LeadStageHistory[]
  revenueTransactions RevenueTransaction[]
  stars               LeadStar[]
  products            LeadProduct[]

  totalAmount        Float?                   @default(0)
  totalAmountHistory LeadTotalAmountHistory[]
  advancePayments    AdvancePayment[]
  fieldEditSummaries LeadFieldEditSummary[]
  fieldEditHistories LeadFieldEditHistory[]
  callSessions       LeadCallSession[]
  callOutcomes       LeadCallOutcome[]
  remarksList        LeadRemark[]
  dynamicValues      LeadDynamicValue[]
  metaLeadImports    MetaLeadImport[]

  @@index([workspaceId, assignedToId, stageId])
  @@index([workspaceId, sourceId, createdAt])
  @@index([workspaceId, deletedAt])
  @@index([workspaceId, isLOB, isClosed])
  @@index([isClosed])
  @@index([workspaceId, isClosed])
  @@index([closureType])
  @@index([closedAt(sort: Desc)])
  @@index([nextFollowUpAt])
  @@index([workspaceId, isClosed, isLOB, stageExpiresAt])
  @@index([workspaceId, stageId, deletedAt, isClosed])
  @@index([workspaceId, assignedToId, deletedAt, isClosed])
  @@index([workspaceId, sourceId, deletedAt, isClosed])
  @@index([workspaceId, lifecycleId, deletedAt, isClosed])
  @@index([workspaceId, nextFollowUpAt, deletedAt, isClosed])
  @@index([workspaceId, createdAt(sort: Desc), deletedAt, isClosed])
  @@index([workspaceId, approvalState, pendingApprovalRequestedAt])
  @@index([name])
  @@index([email])
  @@index([phone])
  @@map("leads")
}

model Product {
  id          String        @id @default(cuid())
  workspaceId String
  name        String
  code        String?
  category    String?
  description String?
  unitPrice   Float
  status      ProductStatus @default(ACTIVE)
  createdById String?
  deletedAt   DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  workspace            Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy            User?                 @relation("ProductCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  leadProducts         LeadProduct[]
  targetProductTargets TargetProductTarget[]

  @@unique([workspaceId, name])
  @@index([workspaceId, status, deletedAt])
  @@index([workspaceId, category])
  @@map("products")
}

model LeadProduct {
  id          String   @id @default(cuid())
  workspaceId String
  leadId      String
  productId   String?
  productName String
  productCode String?
  unitPrice   Float
  quantity    Int
  lineTotal   Float
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  lead      Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  product   Product?  @relation(fields: [productId], references: [id], onDelete: SetNull)
  createdBy User?     @relation("LeadProductCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([workspaceId, leadId])
  @@index([workspaceId, productId])
  @@map("lead_products")
}

model LeadLOBLog {
  id                String   @id @default(cuid())
  leadId            String
  reasonId          String
  remarks           String?
  /// Pipeline stage the lead was in immediately before this LOB event (denormalized name for analytics).
  previousStageId   String?
  previousStageName String?
  changedById       String
  changedAt         DateTime @default(now())
  workspaceId       String

  lead   Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  reason LOBReason @relation(fields: [reasonId], references: [id], onDelete: Restrict)

  @@index([leadId, changedAt])
  @@index([workspaceId, reasonId])
  @@index([previousStageId])
  @@index([workspaceId, previousStageId])
  @@map("lead_lob_logs")
}

model LeadRemark {
  id          String   @id @default(cuid())
  text        String   @db.Text
  leadId      String
  createdById String
  workspaceId String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  lead      Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  createdBy User      @relation(fields: [createdById], references: [id], onDelete: Restrict)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([leadId, createdAt(sort: Desc)])
  @@index([workspaceId, createdById])
  @@map("lead_remarks")
}

model LeadStageHistory {
  id            String   @id @default(cuid())
  leadId        String
  fromStageId   String?
  fromStageName String?
  toStageId     String?
  toStageName   String?
  changedById   String
  changedAt     DateTime @default(now())
  workspaceId   String

  lead      Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([leadId, changedAt])
  @@index([workspaceId, changedAt])
  @@index([toStageId, changedAt])
  @@map("lead_stage_history")
}

model LOBReason {
  id          String          @id @default(uuid())
  workspaceId String
  name        String
  status      LOBReasonStatus @default(ACTIVE)
  createdById String?
  updatedById String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  deletedAt   DateTime?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User?     @relation("LOBReasonCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy User?     @relation("LOBReasonUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  lobLogs   LeadLOBLog[]

  @@index([workspaceId])
  @@index([status])
  @@index([workspaceId, status, createdAt(sort: Desc)])
  @@map("lob_reasons")
}

model LeadStageApproval {
  id            String             @id @default(cuid())
  workspaceId   String
  leadId        String
  fromStageId   String?
  toStageId     String?
  type          String             @default("STAGE_CHANGE") // STAGE_CHANGE or ADVANCE_PAYMENT
  requestedById String
  assignedToId  String?
  status        LeadApprovalStatus @default(PENDING)
  comment       String?
  requestData   Json?
  approvedById  String?
  approvedAt    DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  workspace   Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  lead        Lead       @relation(fields: [leadId], references: [id], onDelete: Cascade)
  fromStage   LeadStage? @relation("LeadStageApprovalFromStage", fields: [fromStageId], references: [id], onDelete: Restrict)
  toStage     LeadStage? @relation("LeadStageApprovalToStage", fields: [toStageId], references: [id], onDelete: Restrict)
  requestedBy User       @relation("LeadStageApprovalRequestedBy", fields: [requestedById], references: [id], onDelete: Restrict)
  assignedTo  User?      @relation("LeadStageApprovalAssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)
  approvedBy  User?      @relation("LeadStageApprovalApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([status])
  @@index([leadId])
  @@index([assignedToId])
  @@index([workspaceId, status, createdAt(sort: Desc)])
  @@index([workspaceId, requestedById, createdAt(sort: Desc)])
  @@map("lead_stage_approvals")
}

model LeadLifeCycleTransition {
  id          String        @id @default(cuid())
  lifecycleId String
  lifecycle   LeadLifeCycle @relation(fields: [lifecycleId], references: [id], onDelete: Cascade)

  fromStageId String
  toStageId   String

  numberOfDays Int
  expiryAction LeadExpiryAction @default(WARN_AND_CHOOSE)
  warningDays  Int              @default(1)

  sortOrder Int

  workspaceId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([lifecycleId])
  @@index([workspaceId])
  @@map("lead_life_cycle_transitions")
}

model LeadDynamicField {
