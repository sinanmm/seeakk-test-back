enum AttendanceType {
  PRESENT
  HALF_DAY
  LEAVE
  WORK_FROM_HOME
  HOLIDAY
  WEEKLY_OFF
  ABSENT
}

enum AttendanceStatus {
  MARKED
  AUTO_GENERATED
  APPROVED
  PENDING
}

model AttendanceRecord {
  id                   String           @id @default(uuid())
  userId               String
  workspaceId          String
  date                 DateTime         @db.Date
  checkInTime          DateTime?
  checkOutTime         DateTime?
  workingHours         Float?
  checkoutCompleted    Boolean          @default(false)
