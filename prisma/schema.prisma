  workflowExecutionId  String
  actionId             String
  position             Int
  status               String              // PENDING, RUNNING, WAITING, COMPLETED, FAILED, SKIPPED
  scheduledAt          DateTime
  startedAt            DateTime?
  completedAt          DateTime?
  attemptCount         Int                 @default(0)
  error                String?             @db.Text
  createdAt            DateTime            @default(now())

  workflowExecution    AutomationExecution @relation(fields: [workflowExecutionId], references: [id], onDelete: Cascade)
  action               AutomationAction    @relation(fields: [actionId], references: [id], onDelete: Cascade)

  @@index([workflowExecutionId])
  @@index([actionId])
  @@map("automation_action_executions")
}

model PlatformBillingSetting {
  id                     String   @id @default(cuid())
  pricePerUserPerMonth   Int      @default(499)
  currency               String   @default("INR")
  upiId                  String   @default("")
  upiPayeeName           String   @default("SEEAKK")
  paymentReferencePrefix String   @default("SEEAKK-PAY")
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@map("platform_billing_settings")
}

model PaymentRequest {
  id                 String   @id @default(cuid())
  workspaceId        String
  requestedUsers     Int
  requestedMonths    Int
  unitPrice          Int
  currency           String
  calculatedAmount   Int
  paymentReference   String   @unique
  status             String   @default("PAYMENT_REQUIRED")
  
  createdBy          String
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  workspace          Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user               User      @relation(fields: [createdBy], references: [id])
  paymentSubmissions PaymentSubmission[]
  verifiedPayments   VerifiedPayment[]

  @@index([workspaceId])
  @@index([createdBy])
  @@map("payment_requests")
}

model PaymentSubmission {
  id                 String   @id @default(cuid())
  paymentRequestId   String
  workspaceId        String
  paymentMethod      String
  utrNumber          String
  paymentDate        DateTime
  proofStorageKey    String
  remarks            String?   @db.Text

  submittedBy        String
  submittedAt        DateTime @default(now())
  status             String   @default("PENDING_VERIFICATION")

  paymentRequest     PaymentRequest @relation(fields: [paymentRequestId], references: [id], onDelete: Cascade)
  workspace          Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user               User           @relation(fields: [submittedBy], references: [id], onDelete: Cascade)
  verifiedPayments   VerifiedPayment[]

  @@index([workspaceId])
  @@index([paymentRequestId])
  @@map("payment_submissions")
}

model VerifiedPayment {
  id                 String   @id @default(cuid())
  workspaceId        String
  paymentRequestId   String
  paymentSubmissionId String?
  
  amount             Int
  currency           String
  unitPriceSnapshot  Int
  requestedUsers     Int
  requestedMonths    Int
  approvedUserLimit  Int

  paymentMethod      String
  utrNumber          String?
  paymentDate        DateTime?

  accessFrom         DateTime?
  accessUntil        DateTime?

  status             String   @default("VERIFIED")
  remarks            String?  @db.Text

  approvedBy         String
  approvedAt         DateTime @default(now())

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  workspace          Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  paymentRequest     PaymentRequest     @relation(fields: [paymentRequestId], references: [id], onDelete: Cascade)
  paymentSubmission  PaymentSubmission? @relation(fields: [paymentSubmissionId], references: [id], onDelete: Cascade)
  user               User               @relation(fields: [approvedBy], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([paymentRequestId])
  @@map("verified_payments")
}

model GraceRecord {
  id                 String   @id @default(cuid())
  workspaceId        String
  
  graceFrom          DateTime @default(now())
  graceUntil         DateTime
  allowedUserLimit   Int

  reason             String   @db.Text
  status             String   @default("ACTIVE")
  
  grantedBy          String
  grantedAt          DateTime @default(now())
  revokedAt          DateTime?

  workspace          Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user               User      @relation(fields: [grantedBy], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@map("grace_records")
}
