  isHoliday            Boolean          @default(false)
  holidayName          String?
  isLocked             Boolean          @default(false)
  lockReason           String?
  createdBy            String?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  // Location & legacy network meta
  latitude                 Float?
  longitude                Float?
  calculatedDistanceMeters Float?
  officeLocationId         String?
  isInsideOfficeRadius     Boolean          @default(false)
  gpsAccuracy              Float?
  ipAddress                String?
  networkName              String?
  routerIp                 String?
  subnet                   String?
  attendanceApplyType      String?          @default("FROM_ANYWHERE")
  isOfficeNetwork          Boolean          @default(false)
  deviceInfo               String?
  geoLocation              String?
  approvalStatus           String           @default("PENDING") // PENDING, PENDING_APPROVAL, CLARIFICATION_REQUESTED, APPROVED, REJECTED
  approvedBy               String?
  approvedAt               DateTime?
  rejectedReason           String?
  supervisorId             String?
  submittedAt              DateTime?        @default(now())
  notes                    String?
  attachmentUrl            String?
  workSummary              String?          @db.Text
  achievements             String?          @db.Text
  pendingTasks             String?          @db.Text
  challenges               String?          @db.Text
  additionalNotes          String?          @db.Text
  rejectedBy               String?
  rejectedAt               DateTime?

  user                     User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([workspaceId])
  @@index([date])
  @@index([userId, date])
  @@index([workspaceId, approvalStatus, date])
  @@map("attendance_records")
}
model AttendanceWarning {
  id           String   @id @default(uuid())
  userId       String
  workspaceId  String
  date         DateTime @db.Date
  reason       String
  warningType  String   // e.g. "ABSENT", "LATE_CHECKIN"
  createdAt    DateTime @default(now())

  @@index([userId])
  @@index([workspaceId])
  @@map("attendance_warnings")
}

model AttendanceSetting {
  id                  String   @id @default(uuid())
  workspaceId         String   @unique
  cutoffTime          String   @default("09:30") // HH:MM format
  enableWarning       Boolean  @default(true)
  warningThreshold    Int      @default(3) // lock account after N warnings
  enableAutoLock      Boolean  @default(false)
  attendanceStartTime String   @default("08:00")
  lateMarkTime        String   @default("09:45")
  autoAbsentTime      String   @default("12:00")
  approvalRequired    Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@map("attendance_settings")
}

model AttendanceUserSetting {
  id                   String   @id @default(uuid())
  workspaceId          String
  userId               String   @unique
  expectedCheckInTime  String
  expectedCheckOutTime String
  createdBy            String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([workspaceId, expectedCheckInTime])
  @@map("attendance_user_settings")
}

model AttendanceLog {
  id          String   @id @default(uuid())
  userId      String
  workspaceId String
  action      String   // e.g. "CHECK_IN", "AUTO_ABSENT", "WARNING_GENERATED"
  details     String?
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([workspaceId])
  @@map("attendance_logs")
}

model AttendanceNetwork {
  id             String   @id @default(uuid())
  workspaceId    String
  officeName     String
  branch         String?
  wifiSsid       String
  routerIp       String
  gateway        String?
  allowedIpRanges String?
  subnet         String?
  macValidation  String?
  isEnabled      Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([workspaceId])
  @@map("attendance_networks")
}

model AttendanceOfficeLocation {
  id            String   @id @default(uuid())
  workspaceId   String
  officeName    String
  branch        String?
  latitude      Float
  longitude     Float
  radiusMeters  Int      @default(50)
  isEnabled     Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  assignedUsers User[]

  @@index([workspaceId])
  @@index([workspaceId, isEnabled])
  @@map("attendance_office_locations")
}

model AttendanceApprovalLog {
  id                 String   @id @default(uuid())
  attendanceRecordId String
  action             String   // e.g. "APPROVE", "REJECT"
  actorId            String
  reason             String?
  createdAt          DateTime @default(now())

  @@index([attendanceRecordId])
  @@map("attendance_approval_logs")
}

model AttendanceNotification {
  id          String   @id @default(uuid())
  workspaceId String
  userId      String
  title       String
  message     String
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([workspaceId])
  @@map("attendance_notifications")
}

model AttendanceAuditLog {
  id          String   @id @default(uuid())
  workspaceId String
  userId      String
  action      String
  details     String?
  ipAddress   String?
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([workspaceId])
  @@map("attendance_audit_logs")
}

model FollowUpExtensionReason {
  id          String    @id @default(cuid())
  reasonName  String
  description String?
  isActive    Boolean   @default(true)
  sortOrder   Int       @default(0)
  workspaceId String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, isActive, sortOrder, reasonName])
  @@map("followup_extension_reasons")
}

model FollowUpSettings {
  id                            String    @id @default(cuid())
  workspaceId                   String    @unique
  dailyLimitEnabled             Boolean   @default(false)
  dailyLimitCount               Int       @default(10)
  isActive                      Boolean   @default(true)
  capacityValidationEnabled     Boolean   @default(false)
  bulkExtensionEnabled          Boolean   @default(false)
  autoDistributionEnabled       Boolean   @default(false)
  defaultBulkExtensionDuration  String    @default("1 Day")
  maxBulkExtensionCount         Int       @default(100)
  createdAt                     DateTime  @default(now())
  updatedAt                     DateTime  @updatedAt

  workspace                     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("followup_settings")
}

model TemporaryBulkExtensionAccess {
  id            String    @id @default(cuid())
  userId        String
  workspaceId   String
  grantedById   String
  duration      String    // "1 Day", "3 Days", "7 Days", "Custom"
  startsAt      DateTime  @default(now())
  expiresAt     DateTime
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user          User      @relation("BulkExtensionUser", fields: [userId], references: [id], onDelete: Cascade)
  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  grantedBy     User      @relation("BulkExtensionGrantedBy", fields: [grantedById], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([userId])
  @@map("temporary_bulk_extension_access")
}

model BulkFollowUpExtension {
  id                    String    @id @default(cuid())
  workspaceId           String
  userId                String    // User who extended
  targetDate            DateTime
  extensionReasonId     String?
  extensionReasonName   String?
  customReason          String?
  followupCount         Int
  autoDistributed       Boolean   @default(false)
  createdAt             DateTime  @default(now())

  workspace             Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([userId])
  @@map("bulk_followup_extensions")
}

model AttendanceSchedule {
  id                      String   @id @default(uuid())
  userId                  String   @unique
  workspaceId             String
  checkInTime             String   @default("09:00") // HH:MM
  checkOutTime            String   @default("18:00") // HH:MM
  gracePeriod             Int      @default(15) // in minutes
  lateMarkThreshold       String   @default("09:45") // HH:MM
  halfDayThreshold        Float    @default(4.0) // in hours
  workingHoursRequirement Float    @default(8.0) // in hours
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  user                    User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@map("attendance_schedules")
}

model LeadTotalAmountHistory {
  id          String   @id @default(cuid())
  leadId      String
  oldAmount   Float
  newAmount   Float
  changedById String
  reason      String
  createdAt   DateTime @default(now())

  lead        Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  changedBy   User     @relation(fields: [changedById], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@index([changedById])
  @@map("lead_total_amount_histories")
}

model AdvancePayment {
  id              String    @id @default(cuid())
  leadId          String
  workspaceId     String
  amount          Float
  paymentDate     DateTime
  proofUrl        String?   @db.Text
  remarks         String?
  status          String    @default("PENDING") // PENDING, APPROVED, REJECTED
  checkNumber     String?
  requestedById   String
  approvedById    String?
  approvedAt      DateTime?
  rejectedById    String?
  rejectedAt      DateTime?
  rejectionReason String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  lead            Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  requestedBy     User      @relation("AdvanceRequestedBy", fields: [requestedById], references: [id], onDelete: Cascade)
  approvedBy      User?     @relation("AdvanceApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  rejectedBy      User?     @relation("AdvanceRejectedBy", fields: [rejectedById], references: [id], onDelete: SetNull)
  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@index([workspaceId])
  @@index([requestedById])
  @@index([approvedById])
  @@index([rejectedById])
  @@map("advance_payments")
}

