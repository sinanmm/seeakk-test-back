{
    "info": {
        "name": "SEEAKK CRM API",
        "description": "Complete Postman collection for the Seeakk CRM backend, including Authentication, Role-Based Access Control, and Rate Limiting.",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "item": [
        {
            "name": "1. Authentication & Security",
            "item": [
                {
                    "name": "1. Register New User",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\r\n  \"name\": \"John Doe\",\r\n  \"email\": \"john@example.com\",\r\n  \"password\": \"SecurePass123!\"\r\n}"
                        },
                        "url": {
                            "raw": "http://localhost:5000/api/auth/register",
                            "protocol": "http",
                            "host": [
                                "localhost"
                            ],
                            "port": "5000",
                            "path": [
                                "api",
                                "auth",
                                "register"
                            ]
                        }
                    }
                },
                {
                    "name": "2. Verify Email (from link in email)",
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": {
                            "raw": "http://localhost:5000/api/auth/verify-email?token=REPLACE_WITH_YOUR_TOKEN",
                            "protocol": "http",
                            "host": [
                                "localhost"
                            ],
                            "port": "5000",
                            "path": [
                                "api",
                                "auth",
                                "verify-email"
                            ],
                            "query": [
                                {
                                    "key": "token",
                                    "value": "REPLACE_WITH_YOUR_TOKEN"
                                }
                            ]
                        }
                    }
                },
                {
                    "name": "3. Standard Login",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            },
                            {
                                "key": "x-device-id",
                                "value": "postman-testing-device-id"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\r\n  \"email\": \"john@example.com\",\r\n  \"password\": \"SecurePass123!\"\r\n}"
                        },
                        "url": {
                            "raw": "http://localhost:5000/api/auth/login",
                            "protocol": "http",
                            "host": [
                                "localhost"
                            ],
                            "port": "5000",
                            "path": [
                                "api",
                                "auth",
                                "login"
                            ]
                        }
                    }
                },
                {
                    "name": "4. Refresh Token (Token Rotation)",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            },
                            {
                                "key": "x-device-id",
                                "value": "postman-testing-device-id"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\r\n  \"refreshToken\": \"PASTE_YOUR_REFRESH_TOKEN_FROM_LOGIN_HERE\"\r\n}"
                        },
                        "url": {
                            "raw": "http://localhost:5000/api/auth/refresh",
                            "protocol": "http",
                            "host": [
                                "localhost"
                            ],
                            "port": "5000",
                            "path": [
                                "api",
                                "auth",
                                "refresh"
                            ]
                        }
                    }
                },
                {
                    "name": "5. Logout / Invalidate Session",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\r\n  \"refreshToken\": \"PASTE_YOUR_REFRESH_TOKEN_HERE_TO_DELETE_IT_FROM_REDIS\"\r\n}"
                        },
                        "url": {
                            "raw": "http://localhost:5000/api/auth/logout",
                            "protocol": "http",
                            "host": [
                                "localhost"
                            ],
                            "port": "5000",
                            "path": [
                                "api",
                                "auth",
                                "logout"
                            ]
                        }
                    }
                }
            ]
        },
        {
            "name": "2. Protected Routes (RBAC)",
            "item": [
                {
                    "name": "1. Get My Profile & Active Sessions",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer PASTE_YOUR_ACCESS_TOKEN_HERE"
                            },
                            {
                                "key": "x-device-id",
                                "value": "postman-testing-device-id"
                            }
                        ],
                        "url": {
                            "raw": "http://localhost:5000/api/auth/me",
                            "protocol": "http",
                            "host": [
                                "localhost"
                            ],
                            "port": "5000",
                            "path": [
                                "api",
                                "auth",
                                "me"
                            ]
                        }
                    }
                },
                {
                    "name": "2. Invite Team Member (Admin/Manager ONLY)",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer PASTE_YOUR_ACCESS_TOKEN_HERE"
                            },
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{}"
                        },
                        "url": {
                            "raw": "http://localhost:5000/api/auth/invite",
                            "protocol": "http",
                            "host": [
                                "localhost"
                            ],
                            "port": "5000",
                            "path": [
                                "api",
                                "auth",
                                "invite"
                            ]
                        }
                    }
                }
            ]
        },
        {
            "name": "3. Server Health",
            "item": [
                {
                    "name": "Health Check",
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": {
                            "raw": "http://localhost:5000/",
                            "protocol": "http",
                            "host": [
                                "localhost"
                            ],
                            "port": "5000",
                            "path": []
                        }
                    }
                }
            ]
        }
    ]
}