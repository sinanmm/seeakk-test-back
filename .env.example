NODE_ENV=production
PORT=5000
DATABASE_URL=postgresql://user:pass@host:5432/dbname
JWT_SECRET=your-jwt-secret
JWT_REFRESH_SECRET=your-refresh-secret
FRONTEND_URL=https://your-frontend.vercel.app
BACKEND_URL=https://your-backend.onrender.com
# CORS list; first origin also used as fallback for invite email links if FRONTEND_URL is unset
ALLOWED_ORIGINS=https://your-frontend.vercel.app
REDIS_URL=redis://...
# Preferred for production: Resend API (no Gmail SMTP). When set, RESEND is used before SMTP.
# https://resend.com — verify your domain, then set EMAIL_FROM to e.g. "Seeakk <noreply@yourdomain.com>"
# RESEND_API_KEY=re_xxxxxxxx
#
# Optional: custom SMTP instead of EMAIL_SERVICE (e.g. SendGrid, Mailgun)
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_SECURE=false
EMAIL_SERVICE=gmail
EMAIL_USER=your@gmail.com
# Gmail: 16-character App Password (Google Account → Security → App passwords), not your login password; 535 BadCredentials otherwise
EMAIL_PASS=your-app-password
EMAIL_FROM=App Name <your@gmail.com>
# Set to true locally if you have not configured Gmail yet (skips startup SMTP verify only; sends still need valid creds)
# EMAIL_SKIP_VERIFY=true
# Follow-up reminder emails (requires FRONTEND_URL + SMTP)
# FOLLOWUP_REMINDER_ENABLED=true
# FOLLOWUP_REMINDER_LEAD_TIME_MINUTES=15
# FOLLOWUP_REMINDER_POLL_SECONDS=30
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
