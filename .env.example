NODE_ENV=production
PORT=5000
DATABASE_URL=postgresql://user:pass@host:5432/dbname
JWT_SECRET=your-jwt-secret
JWT_REFRESH_SECRET=your-refresh-secret
FRONTEND_URL=https://lms-frontend-amber-beta.vercel.app
BACKEND_URL=https://your-backend.onrender.com
# CORS allowlist (comma-separated). Vercel previews matching lms-frontend-*.vercel.app are allowed by default.
ALLOWED_ORIGINS=https://lms-frontend-amber-beta.vercel.app
# Optional: set false to disable auto-allow for *.vercel.app deployment URLs
# CORS_ALLOW_VERCEL=true
# CORS_VERCEL_PROJECT_SLUG=lms-frontend
# ATTENDANCE_DEFAULT_RADIUS_METERS=100
# ATTENDANCE_MAX_GPS_ACCURACY_METERS=200
REDIS_URL=redis://...
# Required/recommended for Render production: Resend API over HTTPS.
# Gmail SMTP ports 465/587 often time out from hosted platforms even with correct credentials.
# https://resend.com — verify your domain, then set EMAIL_FROM to e.g. "Seeakk <noreply@yourdomain.com>"
# RESEND_API_KEY=re_xxxxxxxx
# EMAIL_FROM=Seeakk <noreply@yourdomain.com>
#
# Optional: custom SMTP instead of Resend (best for local/dev or networks that allow outbound SMTP)
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_SECURE=false
EMAIL_SERVICE=gmail
EMAIL_USER=your@gmail.com
# Gmail: 16-character App Password (Google Account → Security → App passwords), not your login password; 535 BadCredentials otherwise
EMAIL_PASS=your-app-password
EMAIL_FROM=App Name <your@gmail.com>
# Set to true locally if you have not configured Gmail yet (skips startup SMTP verify only; sends still need valid creds)
# EMAIL_SKIP_VERIFY=true
# Follow-up reminder emails (requires FRONTEND_URL + SMTP)
# FOLLOWUP_REMINDER_ENABLED=true
# FOLLOWUP_REMINDER_LEAD_TIME_MINUTES=15
# FOLLOWUP_REMINDER_POLL_SECONDS=30
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
